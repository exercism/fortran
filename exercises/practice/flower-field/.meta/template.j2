{{ header }}

program {{ name }}_test_main
  use TesterMain
  use {{ name }}

  implicit none
{% for case in cases %}
  ! Test {{ loop.index }}: {{ case.description }}
  call assert_equal({{ case.expected | fortran_matrix("character(len=1)") }},&
    annotate({{ case.input.garden | fortran_matrix("character(len=1)") }}), "{{ case.description }}")
{% endfor %}
  call test_report()

end program
