{{ header }}

program {{ name }}_test_main
  use TesterMain
  use {{ name }}

  implicit none
{% for case in cases %}
  ! Test {{ loop.index }}: {{ case.description }}
  call assert_equal({{ case.expected | fortran_matrix("integer") }},&
    {{ case.property }}({{ case.input.matrix | fortran_matrix("integer") }}),&
    "{{ case.description }}")
{% endfor %}
  call test_report()

end program
