{{ header }}

program {{ name }}_test_main
  use TesterMain
  use {{ name }}

  implicit none
{% for case in cases %}
  ! Test {{ loop.index }}: {{ case.description }}
{%- if not case.expect_error %}
  call assert_equal({{ case.expected }}, measure({{ case.input.bucketOne}}, {{ case.input.bucketTwo}}, {{ case.input.goal}},  "{{ case.input.startBucket}}"), "{{ case.description }}")
{%- else %}
  call assert_equal(-1, measure({{ case.input.bucketOne}}, {{ case.input.bucketTwo}}, {{ case.input.goal}},  "{{ case.input.startBucket}}")), "{{ case.description }}")
{%- endif %}
{% endfor %}
  call test_report()

end program


{% for case in cases -%}
test_that("{{ case.description }}", {
  bucket_one <- {{ case.input.bucketOne}}
  bucket_two <- {{ case.input.bucketTwo}}
  goal <- {{ case.input.goal}}
  start_bucket <- "{{ case.input.startBucket}}"
{%- if case is error_case %}
  expect_error(measure({{ case.input.bucketOne}}, {{ case.input.bucketTwo}}, {{ case.input.goal}},  "{{ case.input.startBucket}}"))
{%- else %}
  expect_equal(measure(bucket_one, bucket_two, goal, start_bucket),
    list(moves = {{ case.expected.moves }}, goal_bucket = "{{ case.expected.goalBucket }}", other_bucket = {{ case.expected.otherBucket }}))
{% endif -%}
})

{% endfor %}